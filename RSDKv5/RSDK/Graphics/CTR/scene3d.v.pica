; Vertex shader of the GPU 3D scenes (GpuRender.cpp, CMD_SCENE3D): RSDK models transformed, projected and lit as the
; engine's S3D_SOLIDCOLOR_SCREEN / S3D_SOLIDCOLOR_SHADED_BLENDED_SCREEN modes do it in fixed point (Scene3D.cpp),
; here in floats. One instance per draw; the model's frames sit in VRAM and two of them are interpolated.
; v0, v2 = position in frame A / B (model units) ; v1, v3 = normal in frame A / B (1.0 = 16384) ; v4 = colour 0..255
; Assembled with the other renderer shader into one binary (renderer_shbin.h, DVLE 0 the 2D one, 1 the 3D one): programs
; sharing their code switch without citro3d uploading it again (it did for every 3D scene, ~1.3 KB of commands each).
; Regenerate with:  tools/gen-shader.sh renderer RSDKv5/RSDK/Graphics/CTR/gpu.v.pica RSDKv5/RSDK/Graphics/CTR/scene3d.v.pica RSDKv5/RSDK/Graphics/CTR/roto.v.pica
.fvec projection[4]
.fvec wrow[3]   ; world matrix rows: (m0 / 256, m1 / 256, m2 / 256, m3)
.fvec nrow      ; normal matrix row 1 / 256, times 4 (the normals are stored / 4)
.fvec lerp      ; (t, 1 - t, 0, 0)
.fvec scr       ; (2^projectionX, -2^projectionY, screen centre x, screen centre y)
.fvec band      ; (base, slope, Zmax, 0): z / w = base + slope * min(Z, Zmax), the scene's slice of the depth range
.fvec lit       ; (diffuse factor of the normal: 1 / 1024 or 0, 0, 0, alpha 0..255)
.fvec dif       ; diffuse colour (rgb)
.fvec difs      ; 2^-diffuse intensity (rgb)
.fvec spcs      ; specular scale 1 / (1024 * 2^specular intensity) (rgb), 0 unlit
.fvec ortho    ; (1, 0, 0, 0) for the orthographic modes (w = 1, scr = (1/256, 1/256, -screen x, -screen y)), else (0, 1, 0, 0): w = Z
.fvec eye       ; stereoscopic 3D: (shift in pixels at the far end for this eye, Zc, lowest, highest): the screen x moves by
                ; shift * clamp(1 - Zc / Z, lowest, highest); Zc (the player's depth) stays on the screen plane. 0: no 3D
.constf k(0.0, 1.0, 255.0, 0.003921569)
.alias zero   k.xxxx
.alias one    k.yyyy
.alias max255   k.zzzz
.alias inv255 k.wwww

.out outpos position
.out outclr color

.entry main3d
.proc main3d
    ; frame interpolation
    mov r10, lerp
    mul r0, r10.yyyy, v0
    mul r1, r10.xxxx, v2
    add r0, r0, r1
    mov r0.w, one
    mul r2, r10.yyyy, v1
    mul r3, r10.xxxx, v3
    add r2, r2, r3

    ; world position (X, Y, Z)
    dp4 r4.x, wrow[0], r0
    dp4 r4.y, wrow[1], r0
    dp4 r4.z, wrow[2], r0

    ; w: Z for the perspective modes, 1 for the orthographic ones
    mov r9, ortho
    mul r13.x, r9.yyyy, r4.zzzz
    add r13.x, r13.xxxx, r9.xxxx
    ; homogeneous screen position (centre * w + X * kx, centre * w - Y * ky, ., w): the projection divides by w
    mov r6, scr
    mul r7.x, r6.xxxx, r4.xxxx
    mul r7.y, r6.yyyy, r4.yyyy
    mul r8.xy, r6.zwzw, r13.xxxx
    add r7.xy, r7.xyxy, r8.xyxy
    ; stereo: x' += shift * clamp(1 - Zc / Z) * Z (x' is homogeneous: the projection divides by Z)
    mov r9, eye
    rcp r8.z, r4.zzzz
    mul r8.z, r9.yyyy, r8.zzzz
    add r8.z, one, -r8.zzzz
    max r8.z, r9.zzzz, r8.zzzz
    min r8.z, r9.wwww, r8.zzzz
    mul r8.z, r9.xxxx, r8.zzzz
    mul r8.z, r8.zzzz, r13.xxxx
    add r7.x, r7.xxxx, r8.zzzz
    mov r7.z, zero
    mov r7.w, r13.xxxx
    dp4 outpos.x, projection[0], r7
    dp4 outpos.y, projection[1], r7
    dp4 outpos.w, projection[3], r7
    mov r9, band
    min r8.w, r9.zzzz, r4.zzzz
    mul r8.w, r9.yyyy, r8.wwww
    add r8.w, r9.xxxx, r8.wwww
    mul outpos.z, r8.wwww, r13.xxxx

    ; lighting: n = the transformed normal's y
    dp3 r5.x, nrow, r2
    max r11.x, r5.xxxx, -r5.xxxx
    mul r11.y, r5.xxxx, r11.xxxx
    mov r12, spcs
    mul r13, r12, r11.yyyy
    max r13, zero, r13
    min r13, max255, r13
    mov r12, lit
    mul r14, r12.xxxx, r5.xxxx
    mov r12, dif
    add r14, r12, r14
    mov r12, difs
    mul r14, r12, r14
    mul r15, r14, v4
    add r15, r13, r15
    max r15, zero, r15
    min r15, max255, r15
    mov r12, lit
    mov r15.w, r12.wwww
    mul outclr, inv255, r15
    end
.end
